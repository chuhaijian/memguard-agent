# MemGuard 告警配置模板 — 复制为 /etc/memguard.env 后按需填写
# 说明: dry_run=1 时只打印不发送(联调/首次部署安全模式); 填好 key 后设 dry_run=0

# 企业微信机器人 webhook key(群机器人 → 添加机器人 → Webhook 地址末尾 key= 后的部分)
WECOM_KEY=

# Server酱 SendKey (可选, 与 WECOM_KEY 二选一或同时启用)
SERVERCHAN_KEY=

# 联调用例: 覆盖 API host(回显/内网网关), 生产环境留空
ALERT_BASE=

# 1 = 只打印告警不发送(安全), 0 = 真实推送
ALERT_DRY_RUN=1

# 记忆库文件名前缀, 探针按文件名(d_name)前缀匹配
MEMWRITE_PREFIX=ehragent_memory

# 告警批处理推送窗口(秒)
ALERT_INTERVAL=10

# record 入口的 attach 目标(探针独立 watch 前缀, 此值仅满足 record 强校验);
# 记忆库写入方是 python/agent 进程时保持默认即可, 特殊 comm 可覆盖
ATTACH_COMM=python3