[Unit]
Description=MemGuard memwrite Probe + Poison Alert (AgentSight)
#After=network-online.target
#Wants=network-online.target
After=network.target

[Service]
Type=simple
User=root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# 若需自定义 env 路径可改 Environment= 或在此覆盖
Environment=MEMGUARD_ENV_FILE=/etc/memguard.env
WorkingDirectory=/opt/agentsight
ExecStart=/opt/agentsight/run-memguard.sh
Restart=on-failure
RestartSec=5
# SIGINT 让 record 优雅落盘(shutdown signal 分支)
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=append:/var/log/memguard.log
StandardError=append:/var/log/memguard.log
# 进程数/内存保护
TasksMax=128
MemoryMax=2G

[Install]
WantedBy=multi-user.target